# Copy to .env and fill in values. Never commit .env or Telegram session files.
BOT_TOKEN=
ADMIN_IDS=
MAX_HISTORY=20

WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_SECRET=

# Optional shared credentials for automatic import of sessions/*.session.
# You can instead enter these once on the Accounts page.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional DeepSeek bridge settings. The bridge code itself is not bundled.
DEEPSEEK_MODEL=default
DEEPSEEK_THINKING=false
DEEPSEEK_SEARCH=false

# Optional media-provider API keys (can also be set in the web panel).
GIPHY_KEY=
TENOR_KEY=

# ---------------------------------------------------------------------------
# Airdrop agent, Панель управления :1111 (airdrop_web.py) & Telegram-бот (bot_airdrop.py)
# ---------------------------------------------------------------------------
AIRDROP_PANEL_HOST=0.0.0.0
AIRDROP_PANEL_PORT=1111

# Токен отдельного бота от @BotFather и ваш numeric Telegram ID (можно через запятую).
AIRDROP_BOT_TOKEN=
AIRDROP_ADMIN_IDS=

# Парольная фраза для шифрования ключей кошельков (AES-256-GCM + scrypt, минимум 12 символов).
# Храните копию в менеджере паролей: без неё зашифрованные ключи в data/airdrop/keystore/ не открыть.
AIRDROP_KEY_PASSPHRASE=

# Безопасность ончейн-действий (по умолчанию DRY-RUN = 1, реальные транзакции НЕ отправляются).
AIRDROP_DRY_RUN=1
AIRDROP_MAX_TX_VALUE_ETH=0.01
AIRDROP_DAILY_LIMIT_ETH=0.05
AIRDROP_MAX_GAS_GWEI=25
AIRDROP_CONFIRM_ABOVE_ETH=0.005
AIRDROP_ALLOW_UNKNOWN_CONTRACTS=0
AIRDROP_DEFAULT_CHAIN=base

# Расписание и источники поиска (defillama,coingecko,rss,github,manual).
AIRDROP_SOURCES=defillama,coingecko,rss,github,manual
AIRDROP_DISCOVERY_MIN=90
AIRDROP_ELIGIBILITY_MIN=360
AIRDROP_NOTIFY_SCORE=6.0

# При желании переопределите публичные RPC своими (Alchemy/Infura/QuickNode):
# RPC_ETHEREUM=
# RPC_ARBITRUM=
# RPC_BASE=
# RPC_OPTIMISM=
# RPC_POLYGON=
# RPC_ZKSYNC=
# RPC_LINEA=
# RPC_SCROLL=
# RPC_BLAST=

# ─── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=123456:AA...your-token-from-@BotFather
ADMIN_IDS=123456789

# ─── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5050

# ─── Storage ────────────────────────────────────────────────────────────────
DB_PATH=bee_tracker.db

# ─── Tuning ─────────────────────────────────────────────────────────────────
MONITOR_INTERVAL=120
PRICE_TTL=60
HTTP_TIMEOUT=15
XPUB_DEFAULT_GAP=20
XPUB_MAX_GAP=200

# Optional: raises toncenter rate limits
TONCENTER_API_KEY=

# NOTE: there is deliberately no ENCRYPTION_KEY here. BEE Tracker stores no
# secrets — only public addresses and extended public keys — so there is
# nothing to encrypt and no key to leak.
